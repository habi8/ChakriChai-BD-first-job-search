# Optional. Server port (default 4000)
PORT=4000

# Optional. Adzuna global-fallback source — leave unset to disable it.
# Get free keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna has no Bangladesh country endpoint; pick the market used as global fallback (gb, us, in, sg, ...)
ADZUNA_COUNTRY=gb
